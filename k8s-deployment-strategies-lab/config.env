# =========================
# Global
# =========================
NAMESPACE=bank-app

# =========================
# Docker Images
# Replace these with your real images.
# Example:
# SPRINGBOOT_IMAGE=ratanachhan/account-service:latest
# REACT_IMAGE=ratanachhan/react-app:latest
# =========================
SPRINGBOOT_IMAGE=ratana/springboot:latest
REACT_IMAGE=ratana/reactjs:latest
POSTGRES_IMAGE=postgres:18

# =========================
# Application Ports
# =========================
SPRINGBOOT_PORT=9024
REACT_PORT=80
POSTGRES_PORT=5432

# =========================
# PostgreSQL
# For lab use only.
# Do not store production passwords like this.
# =========================
POSTGRES_DB=mydb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mypassword

# =========================
# Spring Boot
# Adjust these variable names if your application
# expects different environment variables.
# =========================
SPRING_PROFILES_ACTIVE=prod
